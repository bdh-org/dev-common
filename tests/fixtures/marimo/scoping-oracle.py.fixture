import marimo

# THE ORACLE FIXTURE. Every cell here is pure stdlib and RUNS, so the test suite can
# ask Python what each cell actually leaves bound instead of asserting what it ought to.
#
# marimo executes a cell's code in the shared notebook namespace, so "what this cell
# defines" is exactly "what names remain bound after the cell body runs at module
# level". test-marimo-graph-check.sh execs each of these bodies and compares that set,
# name for name, against what marimo-graph-check.py computed statically.
#
# That is why the cells are contrived and dependency-free: this file is not a page, it
# is a scoping experiment. Every rule the checker relies on has a cell here, including
# the two whose intuitive answer is wrong -- a comprehension target does not leak even
# though CPython 3.12 lists it in co_varnames (PEP 709 inlines comprehensions), and an
# `except ... as` target is DELETED at the end of its handler.
__generated_with = "0.23.16"
