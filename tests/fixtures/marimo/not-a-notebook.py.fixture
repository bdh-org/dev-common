# A plain module that sits beside the pages -- a helper, a conftest, a __init__. It
# rebinds `by` twice at module level, which is ordinary Python and must not be reported:
# the multiple-definition rule is marimo's, not Python's.
import json


def load(path):
    by = json.loads(path.read_text())
    return by


def summarise(rows):
    by = {}
    for row in rows:
        by.setdefault(row["k"], []).append(row)
    return by
